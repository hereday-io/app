{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/event/:slug",
      "destination": "/api/event/:slug"
    },
    {
      "source": "/faq",
      "destination": "/api/page/faq"
    },
    {
      "source": "/signup",
      "destination": "/api/page/signup"
    },
    {
      "source": "/getting-started",
      "destination": "/api/page/getting-started"
    },
    {
      "source": "/pro",
      "destination": "/api/page/pro"
    },
    {
      "source": "/privacy",
      "destination": "/api/page/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/page/terms"
    },
    {
      "source": "/refund",
      "destination": "/api/page/refund"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app-shell.html"
    }
  ],
  "functions": {
    "api/event/[slug].ts": {
      "includeFiles": "prerendered/**"
    },
    "api/page/[name].ts": {
      "includeFiles": "prerendered/**"
    }
  }
}
