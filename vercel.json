{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://vbhpvboccvufdkujgnmd.supabase.co/functions/v1/sitemap" },
    { "source": "/event/:slug", "destination": "/api/event/:slug" },
    { "source": "/:name(faq|getting-started|privacy|terms|refund)", "destination": "/api/page/:name" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/event/[slug].ts": {
      "includeFiles": "dist/index.html"
    },
    "api/page/[name].ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
