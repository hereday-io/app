{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://vbhpvboccvufdkujgnmd.supabase.co/functions/v1/sitemap" },
    { "source": "/event/:slug", "destination": "/api/event/:slug" },
    { "source": "/faq", "destination": "/api/page/faq" },
    { "source": "/getting-started", "destination": "/api/page/getting-started" },
    { "source": "/privacy", "destination": "/api/page/privacy" },
    { "source": "/terms", "destination": "/api/page/terms" },
    { "source": "/refund", "destination": "/api/page/refund" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/event/[slug].ts": {
      "includeFiles": "dist/index.html"
    },
    "api/page/[name].ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
