# Secrets the edge functions read. Names only — set the values in the
# Supabase dashboard (Edge Functions → Secrets) or with
# `supabase secrets set NAME=value`, and copy this file to .env for a
# local `supabase functions serve --env-file supabase/functions/.env`.
# Never commit the filled-in copy.

# Provided by Supabase on every deployed function; set only for local runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (create-checkout, stripe-webhook, billing functions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Error reporting (_shared/report.ts). The PostHog project API key
# (phc_…), the same public value as the frontend's VITE_POSTHOG_KEY.
# Unset = errors are only logged, not reported.
POSTHOG_KEY=
# Optional; defaults to https://us.i.posthog.com
POSTHOG_HOST=

# Email (send-event-update; the HMAC secret also signs unsubscribe links)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
PUBLIC_BASE_URL=
UNSUBSCRIBE_HMAC_SECRET=

# Mapbox (get-mapbox-token)
MAPBOX_TOKEN=

# Google Search Console (search-console)
GOOGLE_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
